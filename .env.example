# ==========================================
# CVtoWeb - Free Cloud Environment Config
# ==========================================

# 1. AI Extraction Engine (Dual Fallback)
# Get free Gemini API key: https://aistudio.google.com
GEMINI_API_KEY=

# Get free Groq API key: https://console.groq.com
GROQ_API_KEY=

# 2. Database & Cloud PDF Storage (Supabase 100% Free Cloud Tier)
# Get free Supabase credentials: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Paymob Egyptian Payment Gateway (EGP)
# In mock mode, leave these empty or PAYMOB_ENABLE_MOCK=true
PAYMOB_ENABLE_MOCK=true
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC=

# 4. Multi-Tenant Domain Configuration
# Base domain (e.g., yourname.duckdns.org or yourdomain.com)
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000
